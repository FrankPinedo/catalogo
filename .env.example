# ============================================================
# Óptica RK Visión — Catálogo Digital
# Variables de Entorno — Copiar como .env.local para desarrollo
# ============================================================

# Supabase
# Encuéntralos en: https://supabase.com → Tu proyecto → Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# (Opcional) Service Role Key — solo para operaciones de seed/admin
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# URL de la aplicación (en producción Vercel la pone automáticamente)
NEXT_PUBLIC_APP_URL=http://localhost:3000
